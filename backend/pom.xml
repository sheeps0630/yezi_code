<?xml version="1.0" encoding="UTF-8"?>
<!-- 椰吃家后端工程：Spring Boot 3 + Java 17 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 继承 Spring Boot 官方父工程，统一管理依赖版本 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.yechijia</groupId>
  <artifactId>yechijia-backend</artifactId>
  <version>0.2.0</version>
  <name>yechijia-backend</name>
  <description>椰吃家小程序后端服务：解决用户不知道吃什么、喝什么的决策工具</description>

  <properties>
    <!-- 编译使用的 Java 版本 -->
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <!-- Web 启动器：内嵌 Tomcat + Spring MVC + Jackson -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Spring Boot 打包插件：产出可直接运行的 fat jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
